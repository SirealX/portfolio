---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { getCollection } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const projects = await getCollection('projects');
const statusKeys = {
  ongoing:  'project.status.ongoing',
  complete: 'project.status.complete',
  QA:       'project.status.QA',
  paused:   'project.status.paused',
} as const;
---

<section class="mt-32 px-4 w-full">
  <h2 class="text-4xl font-bold text-txt-primary mb-12 tracking-tighter ml-4">
    {t('project.title')}
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full">
    {projects.map((proj) => (
      <div class="group/project relative w-full p-10 rounded-[2.5rem] bg-bg-secondary/10 border border-accent/10 hover:border-glass-border transition-all duration-700 flex flex-col min-h-125">
        
        <div class="mb-8">
          <div class="flex justify-between items-start mb-2">
            
            {/* 🔁 status logic now uses proj.data*/}
            <span class={`text-[10px] font-bold uppercase tracking-[0.3em] ${
              proj.data.status === 'ongoing'
                ? 'text-accent/80'
                : proj.data.status === 'paused'
                ? 'text-amber-500/80'
                : 'text-emerald-500/80'
            }`}>
              {t(statusKeys[proj.data.status])}
            </span>

            <span class="text-[10px] font-bold text-txt-secondary uppercase tracking-[0.2em]">
              {proj.data.year}
            </span>
          </div>

          <h3 class="text-3xl font-bold text-txt-primary tracking-tight leading-tight group-hover/project:text-accent transition-colors duration-500">
            {proj.data.title}
          </h3>
        </div>

        <div class="relative group/section mb-8 p-4 -ml-4 rounded-2xl hover:bg-glass-fill transition-colors">
          <h4 class="text-[10px] uppercase tracking-[0.2em] text-txt-secondary font-bold mb-3">
            {t("project.label.scope")}
          </h4>
          <p class="text-txt-secondary text-[15px] leading-relaxed italic">
            "{proj.data.description}"
          </p>
        </div>

        <div class="relative group/section flex-1 p-4 -ml-4 rounded-2xl hover:bg-glass-fill transition-colors">
          <h4 class="text-[10px] uppercase tracking-[0.2em] text-txt-secondary font-bold mb-4">
            {t("project.label.objectives")}
          </h4>
          <div class="feat-clamp max-h-45 overflow-hidden transition-[max-height] duration-300">
            <ul class="space-y-3">
              {proj.data.features.map(feat => (
                <li class="flex items-start gap-3 text-sm text-txt-secondary group-hover/section:text-txt-primary/90 transition-colors">
                  <span class="h-px w-4 mt-2.5 shrink-0 bg-bg-secondary group-hover/section:bg-accent transition-all"></span>
                  {feat}
                </li>
              ))}
            </ul>
          </div>
          <button
            class="feat-toggle hidden mt-4 text-[10px] font-bold tracking-widest text-accent uppercase hover:underline"
            data-state="closed"
            data-more="Show more [+]"
            data-less="Show less [-]"
          >
            Show more [+]
          </button>
        </div>

        <div class="pt-8 border-t border-accent/10 mt-auto flex items-center justify-between">
          <div class="flex flex-wrap gap-2">
            {proj.data.skills.map(skill => (
              <span class="px-3 py-1 bg-bg-primary/50 border border-accent/10 rounded-full text-[10px] text-txt-secondary font-bold uppercase tracking-widest hover:bg-accent/30 hover:text-accent transition-all duration-300">
                {skill}
              </span>
            ))}
          </div>
        </div>

        <button 
          class="open-drawer-btn text-[10px] font-bold tracking-widest text-accent uppercase mt-4 hover:underline"
          data-project={JSON.stringify(proj.data)} 
        >
          VIEW TECHNICAL LOGS [+]
        </button>

      </div>
    ))}
  </div>
</section>

<script>
  // Reveals the toggle only when a card's objectives actually overflow the
  // clamp height, since item count alone doesn't predict wrapped line count.
  function checkFeatureOverflow() {
    document.querySelectorAll<HTMLElement>('.feat-clamp').forEach(clamp => {
      const btn = clamp.nextElementSibling as HTMLButtonElement | null;
      if (!btn?.classList.contains('feat-toggle')) return;
      if (btn.dataset.state === 'open') return; // don't yank an expanded card shut

      const overflowing = clamp.scrollHeight > clamp.clientHeight + 1;
      btn.classList.toggle('hidden', !overflowing);
    });
  }

  function initFeatureToggles() {
    document.querySelectorAll<HTMLButtonElement>('.feat-toggle').forEach(btn => {
      // avoid double-binding on view-transition swaps
      if (btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';

      btn.addEventListener('click', () => {
        const clamp = btn.previousElementSibling as HTMLElement | null;
        if (!clamp) return;

        const isOpen = btn.dataset.state === 'open';
        clamp.classList.toggle('max-h-45', isOpen);
        clamp.classList.toggle('max-h-none', !isOpen);
        btn.dataset.state = isOpen ? 'closed' : 'open';
        btn.textContent = isOpen ? btn.dataset.more ?? '' : btn.dataset.less ?? '';
      });
    });

    checkFeatureOverflow();
  }

  initFeatureToggles();
  document.addEventListener('astro:after-swap', initFeatureToggles);

  const w = window as unknown as { __featResizeBound?: boolean };
  if (!w.__featResizeBound) {
    w.__featResizeBound = true;
    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(checkFeatureOverflow, 150);
    });
  }
</script>